  m_Text: "\u5929\u738B\u661F\uFF08\u82F1\u6587\uFF1AUranus\uFF0C\u5929\u6587\u7B26\u53F7\uFF1A\u26E2\uFF0C\u5360\u661F\u7B26\u53F7\uFF1A\u2645\uFF09\uFF0C\u4E3A\u592A\u9633\u7CFB\u516B\u5927\u884C\u661F\u4E4B\u4E00\uFF0C\u662F\u592A\u9633\u7CFB\u7531\u5185\u5411\u5916\u7684\u7B2C\u4E03\u9897\u884C\u661F\uFF0818.37~20.08\u5929\u6587\u5355\u4F4D\uFF09\uFF0C\u5176\u4F53\u79EF\u5728\u592A\u9633\u7CFB\u4E2D\u6392\u540D\u7B2C\u4E09\uFF08\u6BD4\u6D77\u738B\u661F\u5927\uFF09\uFF0C\u8D28\u91CF\u6392\u540D\u7B2C\u56DB\uFF08\u5C0F\u4E8E\u6D77\u738B\u661F\uFF09\uFF0C\u51E0\u4E4E\u6A2A\u8EBA\u7740\u56F4\u7ED5\u592A\u9633\u516C\u8F6C\u3002"
