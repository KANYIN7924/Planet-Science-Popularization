  m_Text: "\u6728\u661F\uFF08Jupiter\uFF09 \u592A\u9633\u7CFB\u4E2D\u4F53\u79EF\u6700\u5927\u7684\u884C\u661F\u3002\r\u53E4\u4EBA\u65E9\u5DF2\u8BA4\u8BC6\u8FD9\u9897\u884C\u661F\uFF0C\u7F57\u9A6C\u4EBA\u4EE5\u4E3B\u795E\u6731\u5E87\u7279\u547D\u540D\u8FD9\u9897\u884C\u661F\u3002\u53E4\u4EE3\u4E2D\u56FD\u5219\u79F0\u6728\u661F\u4E3A\u5C81\u661F\uFF0C\u53D6\u5176\u7ED5\u884C\u5929\u7403\u4E00\u5468\u7EA6\u4E3A12\u5E74\uFF0C\u4E0E\u5730\u652F\u76F8\u540C\u4E4B\u6545\u3002\u5230\u897F\u6C49\u65F6\u671F\uFF0C\u300A\u53F2\u8BB0\u2027\u5929\u5B98\u4E66\u300B\u4F5C\u8005\u53F8\u9A6C\u8FC1\u4ECE\u5B9E\u9645\u89C2\u6D4B\u53D1\u73B0\u5C81\u661F\u5448\u9752\u8272\uFF0C\u4E0E\u201C\u4E94\u884C\u201D\u5B66\u8BF4\u8054\u7CFB\u5728\u4E00\u8D77,\u6B63\u5F0F\u628A\u5B83\u547D\u540D\u4E3A\u201C\u6728\u661F\u201D\u3002"
