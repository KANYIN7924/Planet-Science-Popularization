  m_Text: "\u592A\u9633(Sun)\u662F\u592A\u9633\u7CFB\u7684\u4E2D\u5FC3\u5929\u4F53\uFF0C\u5360\u6709\u592A\u9633\u7CFB\u603B\u4F53\u8D28\u91CF\u768499.86%\u3002\u592A\u9633\u7CFB\u4E2D\u7684\u516B\u5927\u884C\u661F\u3001\u5C0F\u884C\u661F\u3001\u6D41\u661F\u3001\u5F57\u661F\u3001\u5916\u6D77\u738B\u661F\u5929\u4F53\u4EE5\u53CA\u661F\u9645\u5C18\u57C3\u7B49\uFF0C\u90FD\u56F4\u7ED5\u7740\u592A\u9633\u516C\u8F6C\uFF0C\u800C\u592A\u9633\u5219\u56F4\u7ED5\u7740\u94F6\u6CB3\u7CFB\u7684\u4E2D\u5FC3\u516C\u8F6C\u3002"
