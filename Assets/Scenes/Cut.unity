  m_Text: "\u5730\u7403\uFF08\u82F1\u6587\u540D\uFF1AEarth\uFF1B\u62C9\u4E01\u6587\uFF1ATerra\uFF09\u662F\u8DDD\u79BB\u592A\u9633\u7684\u7B2C\u4E09\u9897\u884C\u661F\uFF0C\u4E5F\u662F\u76EE\u524D\u4EBA\u7C7B\u5DF2\u77E5\u7684\u552F\u4E00\u5B55\u80B2\u548C\u652F\u6301\u751F\u547D\u7684\u5929\u4F53\u3002\u5730\u7403\u8868\u9762\u7684\u5927\u7EA6
    29.2% \u662F\u7531\u5927\u9646\u548C\u5C9B\u5C7F\u7EC4\u6210\u7684\u9646\u5730\u3002\u5269\u4F59\u7684
    70.8% \u88AB\u6C34\u8986\u76D6\u3002"
